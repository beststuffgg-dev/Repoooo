pico-8 cartridge // http://www.pico-8.com
version 41
__lua__
-- block blast: rg35xx edition
-- pico-8 cart for anbernic handhelds
-- (fake08 / pico-8) and computers

bx,by,cs=4,20,11
cols={8,9,10,11,12,14}
lt={[8]=14,[9]=10,[10]=7,[11]=7,[12]=6,[14]=15,[13]=6,[6]=7,[7]=7}
dk={[8]=2,[9]=4,[10]=9,[11]=3,[12]=1,[14]=2,[13]=1,[6]=13,[7]=6}
praise=split("good!,great!,excellent!,amazing!,incredible!,unbelievable!")
crown="x.x.x/xxxxx/xxxxx"
gem="..x../.xxx./xxxxx/.xxx./..x.."
dxs,dys={-1,1,0,0},{0,0,-1,1}
-- every piece in the game, rows split by /
shapes="x|xx|xxx|xxxx|xxxxx|x/x|x/x/x|x/x/x/x|x/x/x/x/x|xx/xx|xxx/xxx/xxx|xx/xx/xx|xxx/xxx|x./xx|xx/x.|.x/xx|xx/.x|x../x../xxx|..x/..x/xxx|xxx/x../x..|xxx/..x/..x|x./x./xx|.x/.x/xx|xx/x./x.|xx/.x/.x|xxx/x..|xxx/..x|x../xxx|..x/xxx|xxx/.x.|.x./xxx|x./xx/x.|.x/xx/.x|xx./.xx|.xx/xx.|x./xx/.x|.x/xx/x.|x./.x|.x/x.|x../.x./..x|..x/.x./x.."

function _init()
 cartdata("rg35xx_blockblast_1")
 -- deep navy slots, bright blue backdrop
 pal(5,129,1)
 pal(1,140,1)
 shp={}
 for d in all(split(shapes,"|")) do
  local rows,s=split(d,"/",false),{c={}}
  s.h,s.w=#rows,#rows[1]
  for y=1,s.h do
   for x=1,s.w do
    if sub(rows[y],x,x)=="x" then add(s.c,{x-1,y-1}) end
   end
  end
  add(shp,s)
 end
 bh,bl,mx,mo,ab=dget(0),dget(1),max(dget(2),1),dget(3),dget(4)
 mode,lv,st,tt,shk=1,mx,"title",0,0
 pt,ft,cf={},{},{}
 setmenu()
 if mo==0 then music(0) end
end

function setmenu()
 menuitem(1,"music: "..(mo==0 and "on" or "off"),function()
  mo=1-mo dset(3,mo)
  music(mo==0 and 0 or -1)
  setmenu()
  return true
 end)
 menuitem(2,"swap a/b: "..(ab==0 and "off" or "on"),function()
  ab=1-ab dset(4,ab)
  setmenu()
  return true
 end)
 menuitem(3,"quit to title",function() st="title" end)
end

-- a = place/confirm, b = swap/back
function ka() return btnp(4+ab) end
function kb() return btnp(5-ab) end
function ga() return ab==0 and "\142" or "\151" end
function gb() return ab==0 and "\151" or "\142" end

function pick(t) return t[flr(rnd(#t))+1] end

function newgame()
 b,gm={},{}
 for i=0,63 do b[i]=0 end
 sh,sl,dsh,dsl,cb,cm,gl,got,nb=0,0,0,0,0,0,0,0,false
 if mode==2 then advlvl(lv) end
 cx,cy,pt,ft,cf=2,2,{},{},{}
 newhand()
 st="play"
end

function advlvl(l)
 srand(l*99)
 for k=1,min(8+l*2,32) do b[flr(rnd(64))]=pick(cols) end
 local r,c=lines()
 for j in all(r) do b[j*8+flr(rnd(8))]=0 end
 for j in all(c) do b[flr(rnd(8))*8+j]=0 end
 for k=1,200 do
  local i=flr(rnd(64))
  if gl<min(2+l,16) and b[i]>0 and not gm[i] then
   gm[i]=true gl=gl+1
  end
 end
 srand(t())
end

function fits(s,x,y)
 if x<0 or y<0 or x+s.w>8 or y+s.h>8 then return false end
 for p in all(s.c) do
  if b[(y+p[2])*8+x+p[1]]>0 then return false end
 end
 return true
end

function canfit(s)
 for y=0,8-s.h do
  for x=0,8-s.w do
   if fits(s,x,y) then return true end
  end
 end
end

-- rows/cols that would be full with s at x,y
function lines(s,x,y)
 local t,r,c={},{},{}
 for i=0,63 do t[i]=b[i] end
 if s then
  for p in all(s.c) do t[(y+p[2])*8+x+p[1]]=1 end
 end
 for j=0,7 do
  local fr,fc=1,1
  for k=0,7 do
   if t[j*8+k]==0 then fr=nil end
   if t[k*8+j]==0 then fc=nil end
  end
  if fr then add(r,j) end
  if fc then add(c,j) end
 end
 return r,c
end

-- -1 if no room, else most lines it can clear
function best(s)
 local v=-1
 for y=0,8-s.h do
  for x=0,8-s.w do
   if fits(s,x,y) then
    local r,c=lines(s,x,y)
    v=max(v,#r+#c)
   end
  end
 end
 return v
end

-- deal 3 pieces; often favour helpful ones,
-- and make sure at least one fits
function newhand()
 for k=1,12 do
  hand={}
  local ok
  for i=1,3 do
   local bs,bv
   for j=1,rnd()<.4 and 4 or 1 do
    local s=pick(shp)
    local v=best(s)
    if not bs or v>bv then bs,bv=s,v end
   end
   hand[i]={s=bs,c=pick(cols)}
   ok=ok or bv>=0
  end
  if ok then break end
 end
 sel=1
 clamp()
end

function clamp()
 local s=hand[sel].s
 cx,cy=mid(0,cx,8-s.w),mid(0,cy,8-s.h)
end

function swap()
 repeat sel=sel%3+1 until hand[sel]
 clamp()
end

function addsc(n)
 sl=sl+n
 while sl>=10000 do sl=sl-10000 sh=sh+1 end
 if mode==1 and (sh>bh or sh==bh and sl>bl) then
  if not nb and bh+bl>0 then pop("new best!",10) sfx(10) end
  nb,bh,bl=true,sh,sl
  dset(0,bh) dset(1,bl)
 end
end

-- score as text (two halves: pico-8
-- numbers stop at 32767)
function scs(h,l)
 if h<1 then return tostr(l) end
 local s=tostr(l)
 while #s<4 do s="0"..s end
 return h..s
end

function pop(s,c)
 add(ft,{s=s,c=c,t=0,y=50+#ft*8})
end

function clr(i)
 local c=b[i]
 if c>0 then
  local x,y=bx+i%8*cs,by+flr(i/8)*cs
  add(cf,{x=x,y=y,c=c,t=10})
  for k=1,3 do
   add(pt,{x=x+5,y=y+5,dx=rnd(2)-1,dy=-rnd(2),c=c,t=20+rnd(10)})
  end
  if gm[i] then
   got=got+1 gm[i]=nil
   for k=1,6 do
    add(pt,{x=x+5,y=y+5,dx=rnd(3)-1.5,dy=-rnd(3),c=7,t=30})
   end
  end
  b[i]=0
 end
end

function place()
 local h=hand[sel]
 local s=h.s
 if not fits(s,cx,cy) then sfx(6) shk=3 return end
 local r,c=lines(s,cx,cy)
 for p in all(s.c) do b[(cy+p[2])*8+cx+p[1]]=h.c end
 sfx(1)
 addsc(#s.c)
 local n=#r+#c
 for j in all(r) do for k=0,7 do clr(j*8+k) end end
 for j in all(c) do for k=0,7 do clr(k*8+j) end end
 if n>0 then
  -- combo grows while you keep clearing;
  -- 3 placements without a clear breaks it
  cb,cm=cb+1,0
  local p,q=5*n*(n+1)*min(cb,20),min(n+flr(cb/3),6)
  addsc(p)
  sfx(1+min(q,4))
  shk=min(n*2,8)
  pop(praise[q],pick(cols))
  pop("+"..p,7)
  if cb>1 then pop("combo "..cb,14) end
  local e=true
  for i=0,63 do if b[i]>0 then e=false end end
  if e then addsc(300) pop("all clear! +300",11) sfx(10) end
 else
  cm=cm+1
  if cm>=3 then cb=0 end
 end
 hand[sel]=false
 if hand[1] or hand[2] or hand[3] then swap() else newhand() end
 if mode==2 and got>=gl then
  st,ot="win",0
  sfx(9)
  if lv>=mx then mx=lv+1 dset(2,mx) end
  return
 end
 for i=1,3 do
  if hand[i] and canfit(hand[i].s) then return end
 end
 st,ot="over",0
 sfx(8)
end

function _update60()
 tt=tt+1
 shk=max(shk-.5,0)
 for p in all(pt) do
  p.x=p.x+p.dx p.y=p.y+p.dy p.dy=p.dy+.15 p.t=p.t-1
  if p.t<0 then del(pt,p) end
 end
 for f in all(cf) do
  f.t=f.t-1
  if f.t<0 then del(cf,f) end
 end
 for f in all(ft) do
  f.t=f.t+1
  if f.t>50 then del(ft,f) end
 end
 if st=="title" then
  if btnp(2) or btnp(3) then mode=3-mode sfx(0) end
  if mode==2 then
   if btnp(0) then lv=max(lv-1,1) sfx(0) end
   if btnp(1) then lv=min(lv+1,mx) sfx(0) end
  end
  if ka() then sfx(7) newgame() end
  return
 end
 -- roll the shown score up to the real one
 if sh-dsh>2 then dsh,dsl=sh,sl end
 local d=(sh-dsh)*10000+sl-dsl
 if d>0 then
  dsl=dsl+max(1,flr(d/8))
  while dsl>=10000 do dsl=dsl-10000 dsh=dsh+1 end
 end
 if st=="play" then
  for i=0,3 do
   if btnp(i) then
    cx,cy=cx+dxs[i+1],cy+dys[i+1]
    sfx(0)
   end
  end
  clamp()
  if ka() then place()
  elseif kb() then swap() sfx(7) end
 else
  ot=ot+1
  if ot>45 then
   if ka() then
    if st=="win" then lv=min(lv+1,mx) end
    newgame()
   elseif kb() then st="title" end
  end
 end
end

function bm(s,x,y,c)
 local rows=split(s,"/",false)
 for j=1,#rows do
  for i=1,#rows[j] do
   if sub(rows[j],i,i)=="x" then pset(x+i-1,y+j-1,c) end
  end
 end
end

-- bevelled block, like the real thing
function blk(x,y,c,s)
 s=s or 10
 local e=s-1
 rectfill(x,y,x+e,y+e,c)
 line(x,y,x+e,y,lt[c])
 line(x,y,x,y+e,lt[c])
 line(x+1,y+e,x+e,y+e,dk[c])
 line(x+e,y+1,x+e,y+e,dk[c])
end

function otx(s,x,y,c)
 for i=-1,1 do
  for j=-1,1 do print(s,x+i,y+j,0) end
 end
 print(s,x,y,c)
end

function ctx(s,y,c) otx(s,64-#s*2,y,c) end

function _draw()
 cls(1)
 camera(rnd(shk)-shk/2,rnd(shk)-shk/2)
 if st=="title" then drawtitle() else drawgame() end
 camera()
end

function drawtitle()
 for i=0,11 do
  blk(i*37%120,(tt*(.2+i%3*.15)+i*29)%150-20,cols[i%6+1])
 end
 local w1,w2="block","blast"
 for k=1,5 do
  local o=sin(tt/90+k/10)*2
  for r=0,1 do
   local x,y=31+k*11,18+r*13+o
   blk(x,y,cols[k+r])
   print(sub(r==0 and w1 or w2,k,k),x+3,y+3,dk[cols[k+r]])
   print(sub(r==0 and w1 or w2,k,k),x+3,y+2,7)
  end
 end
 ctx("rg35xx edition",48,10)
 local o={"classic","adventure \139 lv "..lv.." \145"}
 for k=1,2 do
  local y=62+k*12
  if mode==k then rectfill(14,y-3,114,y+7,0) end
  ctx(o[k],y,mode==k and 7 or 6)
 end
 if mode==1 then
  bm(crown,38,102,10)
  print("best "..scs(bh,bl),46,101,10)
 else
  print("unlocked: lv "..mx,38,101,11)
 end
 ctx(ga().." start",114,7)
end

function drawgame()
 -- top bar
 if mode==1 then
  bm(crown,3,3,10)
  print(scs(bh,bl),10,2,10)
 else
  print("lv "..lv,3,2,11)
  bm(gem,100,2,7)
  print(got.."/"..gl,107,2,7)
 end
 ctx(scs(dsh,dsl),10,7)
 -- board
 rectfill(bx-2,by-2,bx+88,by+88,0)
 local h=st=="play" and hand[sel]
 local pv,ok={}
 if h then
  ok=fits(h.s,cx,cy)
  if ok then
   -- light up lines this move would clear
   local r,c=lines(h.s,cx,cy)
   for j in all(r) do for k=0,7 do pv[j*8+k]=1 end end
   for j in all(c) do for k=0,7 do pv[k*8+j]=1 end end
  end
 end
 for i=0,63 do
  local x,y,c=bx+i%8*cs,by+flr(i/8)*cs,b[i]
  if c>0 then
   if pv[i] then c=h.c end
   if st=="over" and flr(i/8)<ot/4 then c=6 end
   blk(x,y,c)
   if gm[i] then
    bm(gem,x+2,y+2,7)
    if (tt+i*7)%90<6 then pset(x+4,y+4,12) end
   end
  else
   rectfill(x,y,x+9,y+9,5)
  end
 end
 for f in all(cf) do
  local m=(10-f.t)/2
  rectfill(f.x+m,f.y+m,f.x+9-m,f.y+9-m,f.t>7 and 7 or f.c)
 end
 -- the piece you are holding
 if h then
  for p in all(h.s.c) do
   local x,y=bx+(cx+p[1])*cs,by+(cy+p[2])*cs
   if ok then
    -- lifted off the board, with a shadow
    rectfill(x+1,y+1,x+10,y+10,0)
    blk(x-1,y-1,h.c)
    rect(x-1,y-1,x+8,y+8,tt%40<20 and 7 or lt[h.c])
   else
    fillp(23130.5)
    rectfill(x,y,x+9,y+9,h.c)
    fillp()
    rect(x,y,x+9,y+9,8)
   end
  end
 end
 -- tray: the three pieces
 for i=1,3 do
  local y,h=18+(i-1)*31,hand[i]
  if i==sel and st=="play" then
   rect(95,y,126,y+28,tt%30<20 and 7 or 6)
  end
  if h then
   local s=h.s
   local c=canfit(s) and h.c or 6
   for p in all(s.c) do
    blk(111-s.w*3+p[1]*6,y+15-s.h*3+p[2]*6,c,5)
   end
  end
 end
 for p in all(pt) do pset(p.x,p.y,p.c) end
 for f in all(ft) do
  if f.t<40 or tt%4<2 then
   otx(f.s,48-#f.s*2,f.y-f.t/3,f.c)
  end
 end
 -- bottom bar: combo + controls
 if cb>0 then
  print("combo "..cb,3,116,14)
  for k=1,3 do
   rectfill(38+k*5,116,41+k*5,119,k<=3-cm and 14 or 5)
  end
 end
 print(ga().."place "..gb().."swap",70,116,6)
 -- end screens
 if st~="play" and ot>40 then
  rectfill(12,38,116,94,0)
  rect(12,38,116,94,7)
  if st=="win" then ctx("level "..lv.." clear!",44,11)
  else ctx(mode==1 and "no more space!" or "level failed",44,8) end
  ctx("score "..scs(sh,sl),56,7)
  if mode==1 then ctx(nb and "new best!" or "best "..scs(bh,bl),65,10) end
  ctx(ga()..(st=="win" and "next " or "retry ")..gb().."menu",82,6)
 end
end
