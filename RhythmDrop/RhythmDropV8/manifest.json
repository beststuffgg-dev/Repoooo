{
  "manifest_version": 3,
  "name": "RhythmDrop",
  "version": "8.0",
  "description": "A rhythm game with a 150-level campaign across ten historically themed areas, XP progression, daily rewards, twelve instruments, a level creator and a shop.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "RhythmDrop",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "V8"
}
